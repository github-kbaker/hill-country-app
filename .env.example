# ── Hill Country Appliance Repair — environment ──────────────────────────────
# Copy to .env.local (gitignored). Never commit real secrets.

# --- Stripe (TEST MODE ONLY in this environment) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- PayPal (SANDBOX) ---
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_SECRET=sandbox_client_secret
PAYPAL_WEBHOOK_ID=WH-xxxxxxxxxx
PAYPAL_MODE=sandbox

# --- App ---
NEXT_PUBLIC_BASE_URL=https://www.hillcountrystumpco.com

# --- Database (Turso/libsql) — REQUIRED in production; dev falls back to team-db ---
# Local/file URL (migrations & tests): file:./data/app.db
# Remote Turso URL: libsql://<database>-<org>.turso.io
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# --- Customer email (final invoices & receipts) — one of: ---
# Preferred: Resend
RESEND_API_KEY=re_xxx
# Alternative: dedicated SMTP for customer mail (business EMAIL_* is never used)
# SCHEDULE_EMAIL_HOST=smtp.example.com
# SCHEDULE_EMAIL_USER=billing@example.com
# SCHEDULE_EMAIL_PASS=xxx
# SCHEDULE_EMAIL_PORT=587

# --- Business/admin SMTP (internal notifications only) ---
EMAIL_HOST=smtp.example.com
EMAIL_USER=admin@example.com
EMAIL_PASS=xxx
EMAIL_PORT=587

# --- Admin API auth ---
ADMIN_API_TOKEN=change-me
# Dev fallback when unset: hc-admin-dev-token-2026 (never use in production)

# --- Testing ---
# EMAIL_DRY_RUN=true   # record 'dry_run' notification rows, never send
